{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portofolio-norak",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portofolio-norak-db",
      "database_id": "00000000-0000-0000-0000-000000000000", // Generate:`pnpm wrangler d1 create portofolio-norak-db`
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "portofolio-norak-media" }
  ]
}
